<h2>Card</h2>
<div class="grid" style="--min: 30ch;">
  <article class="card">
    <a href="/sandbox/">
      <img src="{{ site.defaultImage }}" alt="{{ site.defaultImageAlt }}" class="img-responsive" width="400" height="225" loading="lazy">
    </a>
    <a href="/sandbox/">
      <h2>Card title</h2>
    </a>
    <time>1 January 2026</time>
    <p>Card body copy — the same markup used by the articles-index card grid.</p>
    <a href="/sandbox/" class="btn btn--primary outline">Continue Reading</a>
  </article>
</div>

<h2>Pricing card</h2>
<div class="pricing-card__wrapper">
  <div class="pricing-card">
    <div class="pricing-card__header">
      Package name
    </div>
    <div class="pricing-card__body">
      <ul class="pricing-card__list">
        <li class="card-element">Feature one</li>
        <li class="card-element">Feature two</li>
        <li class="card-element">Feature three</li>
      </ul>
    </div>
  </div>
</div>

<h2>Gallery tile</h2>
<div class="gallery" style="max-width: 20rem;">
  <div class="gallery__box">
    <img class="gallery__img" src="{{ site.defaultImage }}" alt="{{ site.defaultImageAlt }}">
    <h5 class="gallery__caption">Gallery title</h5>
  </div>
</div>

