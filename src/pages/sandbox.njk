<h2>Forms</h2>

<form>
  <fieldset class="fieldset">
    <label for="sandbox-name">Full Name</label>
    <input class="input" type="text" id="sandbox-name" placeholder="Placeholder text">

    <label for="sandbox-disabled">Disabled input</label>
    <input class="input" type="text" id="sandbox-disabled" value="Can't touch this" disabled>

    <label for="sandbox-select">Select</label>
    <select class="select" id="sandbox-select">
      <option value="" selected disabled>Choose</option>
      <option value="one">Option one</option>
      <option value="two">Option two</option>
    </select>

    <div class="control">
      <input class="control__input" type="checkbox" id="sandbox-checkbox">
      <label class="control__label" for="sandbox-checkbox">Checkbox</label>
    </div>

    <div class="control">
      <input class="control__input" type="radio" name="sandbox-radio" id="sandbox-radio-1" checked>
      <label class="control__label" for="sandbox-radio-1">Radio one</label>
    </div>
    <div class="control">
      <input class="control__input" type="radio" name="sandbox-radio" id="sandbox-radio-2">
      <label class="control__label" for="sandbox-radio-2">Radio two</label>
    </div>
  </fieldset>
</form>

