{% include 'partials/site-head.njk' %}

{% set prevPost = collections.post | previousPost(page.url) %}
{% set nextPost = collections.post | nextPost(page.url) %}

<div class="fh__wrapper">

  {% include 'partials/header.njk' %}

  <main class="main__content">

    <article class="flow">

      {% include 'partials/page-banner.njk' %}

      <p class="article__byline">By {{ author }} &middot; <time datetime="{{ page.date.toISOString() }}">{{ page.date | postDate }}</time></p>

      {% if tags %}
        <p class="article__tags cluster">
          {% for t in tags %}
            {% if t != 'post' %}<a href="/tags/{{ t | slugify }}/">#{{ t }}</a>{% endif %}
          {% endfor %}
        </p>
      {% endif %}

      <div class="prose flow">
        {{ content | safe }}
      </div>

      {% if prevPost or nextPost %}
        <nav class="article__pager cluster" aria-label="Article navigation">
          {% if prevPost %}<a href="{{ prevPost.url }}">&larr; {{ prevPost.data.title }}</a>{% endif %}
          {% if nextPost %}<a href="{{ nextPost.url }}">{{ nextPost.data.title }} &rarr;</a>{% endif %}
        </nav>
      {% endif %}

    </article>

  </main>

  {% include 'partials/footer.njk' %}

</div>

{% include 'partials/body-close.njk' %}